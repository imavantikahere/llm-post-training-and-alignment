# RunPod Serverless worker with C/C++ toolchain for Unsloth/Triton JIT kernels.
# Select this file as the Dockerfile path in RunPod's GitHub deployment settings.
# Build context: repository root.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PROJECT_ROOT=/runpod-volume/llm-post-training \
    HF_HOME=/runpod-volume/hf-cache \
    RUNPOD_VOLUME_MOUNT=/runpod-volume

# Unsloth/Triton compiles Qwen kernels at runtime; this image needs gcc/g++.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY gpu_backend/serverless/requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt

COPY gpu_backend/inference_engine.py /app/inference_engine.py
COPY gpu_backend/serverless/handler.py /app/handler.py

CMD ["python", "-u", "/app/handler.py"]
